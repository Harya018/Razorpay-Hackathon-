# SQLite for Phase 1. Swapping to Postgres later is just changing this URL —
# models use SQLAlchemy ORM only, no SQLite-specific SQL.
DATABASE_URL=sqlite:///./app.db

# Razorpay TEST MODE keys only (rzp_test_...). Get these from the Razorpay
# Dashboard -> Settings -> API Keys (make sure "Test Mode" is toggled on).
# NEVER commit real keys — this file only holds placeholders.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# From Razorpay Dashboard -> Settings -> Webhooks, when you create the
# webhook pointing at POST /webhook/razorpay.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

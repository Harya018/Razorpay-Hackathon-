# SQLite by default for zero-friction local dev — models use SQLAlchemy
# ORM only, no SQLite-specific SQL, so swapping to Postgres for deployment
# is purely a URL change. For Render, paste Render's own Postgres
# "Internal Database URL" here as-is — it comes back as postgres://, and
# app/database.py's normalize_database_url() rewrites that to
# postgresql+psycopg:// automatically. Schema is managed by Alembic
# (`alembic upgrade head`) — see README.md's "Database setup" section.
DATABASE_URL=sqlite:///./app.db

# The deployed frontend's origin(s) — used to build the CORS allowlist.
# Comma-separate multiple origins (e.g. a Vercel preview URL alongside
# the production one). Never leave this as "*" once real user auth
# tokens are involved (allow_credentials=True + a wildcard origin is
# both meaningless per the CORS spec and a real data-exposure risk).
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Supabase Auth — human-facing identity only, never consulted by
# policy-gate or any pricing/discount decision. Get SUPABASE_URL from
# your Supabase project's Settings -> API page. Leave SUPABASE_JWT_SECRET
# blank to verify tokens via Supabase's public JWKS endpoint instead (no
# shared secret needed); set it (Settings -> API -> JWT Secret) only if
# your project still uses the legacy HS256 signing key. NEVER put the
# Supabase service-role key here or anywhere server-side in this
# project — it isn't needed, since the backend only ever verifies
# tokens, it never calls Supabase's admin API.
#
# LOCAL DEMO DEFAULTS (work out of the box, no Supabase project needed):
# leave SUPABASE_URL blank, keep the local-only SUPABASE_JWT_SECRET below,
# and DEMO_MODE=1 (bottom of this file). The dashboard's "Sign in (demo)"
# button then mints a token signed with this secret, verified by the
# exact same code path a real Supabase token goes through. For a real
# deployment, replace the secret with your project's real JWT Secret (or
# blank it and set SUPABASE_URL to use JWKS), and set DEMO_MODE=0.
SUPABASE_URL=
SUPABASE_JWT_SECRET=local-dev-only-not-a-real-supabase-secret-change-me

# Comma-separated allowlist of Google-login emails promoted to
# MERCHANT_ADMIN — the simplest way to configure "who is Priya" for a
# demo without building a Supabase admin-role management UI. The first
# address is also who the demo sign-in signs you in as.
MERCHANT_ADMIN_EMAILS=demo-merchant@example.com

# Razorpay TEST MODE keys only (rzp_test_...). Get these from the Razorpay
# Dashboard -> Settings -> API Keys (make sure "Test Mode" is toggled on).
# NEVER commit real keys — this file only holds placeholders.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# From Razorpay Dashboard -> Settings -> Webhooks, when you create the
# webhook pointing at POST /webhook/razorpay.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Groq API key for the seller negotiation agent (Phase 2). Groq's API is
# OpenAI-compatible; we call it via the `openai` SDK pointed at
# https://api.groq.com/openai/v1. Get a key at https://console.groq.com. Never commit a real key.
GROQ_API_KEY=gsk_your-key-here

# Optional second key from a DIFFERENT Groq account, used automatically as
# a fallback if GROQ_API_KEY hits its daily token quota mid-request. Leave
# blank if you don't have one — the app runs fine with just GROQ_API_KEY.
GROQ_API_KEY_2=

GROQ_MODEL=openai/gpt-oss-120b

# Optional next fallback tier, tried only after BOTH Groq keys are
# exhausted — Gemini via Google's OpenAI-compatible endpoint
# (https://generativelanguage.googleapis.com/v1beta/openai/). This is a
# genuinely separate provider/quota pool, unlike a second Groq key on the
# same account. Get a free key at https://aistudio.google.com/apikey.
# Leave blank to skip this fallback tier entirely.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# policy-gate's own URL — 127.0.0.1, not "localhost", locally (see
# README's "Known Gotchas" for the measured reason). For Render, this is
# the policy-gate service's internal/private URL.
POLICY_GATE_URL=http://127.0.0.1:8001

# Must match policy-gate's own GATE_SECRET (policy-gate/.env.example)
# exactly. Policy-gate uses it to mint unforgeable approval tokens; this
# backend's only use of it is authenticating admin-only calls to
# policy-gate's /rules endpoints (adjusting discount limits from the
# Merchant Dashboard). Leave blank and rule-adjustment calls fail closed
# (503) rather than silently working unauthenticated. The placeholder
# below matches policy-gate/.env.example's so a fresh local checkout
# works immediately — replace BOTH with the same `openssl rand -hex 32`
# value before deploying.
GATE_SECRET=change-me-to-a-real-random-secret

# DEMO_MODE: presentation-only flag. Consulted by the LLM provider chain
# (alongside DEMO_FALLBACK_MODE below) to allow a deterministic templated
# response as its last fallback tier instead of erroring out if every real
# provider is unreachable — see the `settings.DEMO_FALLBACK_MODE or
# settings.DEMO_MODE` checks in app/agent/nodes.py. Also gates POST
# /auth/demo-login (app/routes/auth.py), a one-click sign-in for local
# demos with no real Supabase/Google OAuth project configured. Never
# touches pricing, discount approval, or payment verification. ON by
# default here so a fresh local checkout can sign in to the dashboard
# immediately; set to 0 in any deployment that has real Supabase/Google
# OAuth configured.
DEMO_MODE=1
# SEED_CATALOG_ON_STARTUP: for hosts with no shell access (Render free
# tier). When true, startup runs scripts/seed_catalog.py's seed() ONLY if
# the products table is empty — a fresh database gets Priya's Shop's 12
# products automatically; an already-populated catalog is left untouched
# (stock, prices, and merchant edits are never reset by a restart). Safe
# to leave enabled. Set true on Render's backend service.
SEED_CATALOG_ON_STARTUP=false

# DEMO_FALLBACK_MODE: an older, narrower resilience flag — see the
# comment on this setting in app/config.py for its exact, limited scope.
DEMO_FALLBACK_MODE=0

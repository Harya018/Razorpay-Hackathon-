# The seller's agent-commerce interface (see /docs/agent-commerce-interface.md
# in the sibling project root).
SELLER_BASE_URL=http://127.0.0.1:8010

# The human-negotiation endpoints (/negotiate/start, /negotiate/message)
# live on the same backend process as SELLER_BASE_URL above — this is
# kept as a separate variable only because the two APIs are conceptually
# distinct (agent-commerce vs. human negotiation), not because they run
# on different hosts in this dev setup.
BACKEND_BASE_URL=http://127.0.0.1:8010

# This attacker's OWN registered buyer-agent identities. Two are needed
# for the cross-identity token-theft test in token_replay_variants.py.
# Obtained by calling POST /agent/v1/register once each — see README.md.
ATTACKER_A_ID=red-team-attacker-a
ATTACKER_A_KEY=bak_your_key_here
ATTACKER_B_ID=red-team-attacker-b
ATTACKER_B_KEY=bak_your_key_here

# Direct SQLite file paths — ONLY used by attacks that explicitly bypass
# the application layer on purpose (audit_tamper_attempt.py,
# token_replay_variants.py's backdated-timestamp and stale-price cases).
# Paths are relative to THIS directory by default, matching this
# project's dev layout (all services checked out as siblings).
BACKEND_DB_PATH=../backend/app.db
POLICY_GATE_DB_PATH=../policy-gate/policy_gate.db

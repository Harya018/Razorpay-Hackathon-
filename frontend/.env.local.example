# 127.0.0.1, not "localhost" — on Windows dev machines, browser fetches
# (and every other HTTP client in this project) to "localhost" can try
# IPv6 first and fall back, adding real, measurable latency (confirmed
# live: ~357ms vs ~24ms for the same request in Chromium; ~2s vs ~16ms
# for backend/buyer-agent's Python `requests` calls). See README.md's
# "Known Gotchas" section.
VITE_API_BASE_URL=http://127.0.0.1:8010

# Seconds of cart inactivity before an automatic negotiation is
# triggered. See useCartAbandonment.js.
VITE_CART_ABANDONMENT_THRESHOLD_SECONDS=60

# Supabase Auth — public/frontend-safe values ONLY (the anon key is
# designed to be exposed to a browser; it grants no privileges on its
# own, every real permission check happens server-side in backend's
# app/auth.py against the JWT this key's login flow produces). NEVER put
# a Supabase service-role key in a VITE_ prefixed variable or anywhere in
# this frontend — anything prefixed VITE_ is bundled into the shipped
# JS and readable by anyone. Get these from your Supabase project's
# Settings -> API page.
#
# Real Google sign-in (production): set both. The app then uses the
# official @supabase/supabase-js PKCE flow — sign-in returns to
# <your-origin>/auth/callback, which must be on the Supabase project's
# Authentication -> URL Configuration -> Redirect URLs allowlist.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Dev/demo ONLY: with the two values above blank AND this set to "true",
# the login page offers "Continue as Customer" / "Merchant Portal" demo
# personas backed by the backend's DEMO_MODE=1 demo-login. It is ignored
# whenever a real Supabase project is configured, and must be absent or
# "false" in any production build.
VITE_DEMO_LOGIN=true

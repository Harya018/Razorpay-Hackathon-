# 127.0.0.1, not "localhost" — on Windows dev machines, browser fetches
# (and every other HTTP client in this project) to "localhost" can try
# IPv6 first and fall back, adding real, measurable latency (confirmed
# live: ~357ms vs ~24ms for the same request in Chromium; ~2s vs ~16ms
# for backend/buyer-agent's Python `requests` calls). See README.md's
# "Known Gotchas" section.
VITE_API_BASE_URL=http://127.0.0.1:8010

# Seconds of cart inactivity before an automatic negotiation is
# triggered. See useCartAbandonment.js.
VITE_CART_ABANDONMENT_THRESHOLD_SECONDS=60

# The seller's agent-commerce interface AND human-negotiation endpoints —
# both live on the same backend process in this dev setup.
SELLER_BASE_URL=http://127.0.0.1:8010
BACKEND_BASE_URL=http://127.0.0.1:8010

# Prefix used when this suite registers its own fresh buyer-agent identity
# each run (see attacks/concurrency.py) — no long-lived credential needed.
ATTACKER_ID_PREFIX=redteam-async

# Same value as backend/.env's RAZORPAY_WEBHOOK_SECRET — used ONLY by
# attacks/replay.py to mint the single "captured" webhook artifact those
# tests then replay (see config.py's comment for why this is a scoped
# exception, not a general secret-theft assumption).
RAZORPAY_WEBHOOK_SECRET=

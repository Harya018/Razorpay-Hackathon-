# The seller's agent-commerce interface (see /docs/agent-commerce-interface.md
# in the sibling project root).
SELLER_BASE_URL=http://127.0.0.1:8010

# Obtained by calling POST /agent/v1/register once — see README.md.
BUYER_AGENT_ID=your-bot-name-here
BUYER_API_KEY=bak_your_key_here

# This buyer agent's OWN LLM credentials — a separate account/key from
# whatever the seller uses, even if it happens to be the same provider.
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional fallback tier, tried only if Groq is rate-limited — a genuinely
# separate provider/quota pool. Get a free key at https://aistudio.google.com/apikey.
# Leave blank to skip this fallback tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

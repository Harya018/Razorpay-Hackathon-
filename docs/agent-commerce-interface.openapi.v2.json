    "/agent/v1/purchase": {
      "post": {
        "summary": "Agent Purchase",
        "operationId": "agent_purchase_agent_v1_purchase_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PurchaseRequest"
              }
            }
          }
        },
        "responses": {
          "402": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PurchaseTermsResponse"
                }
              }
            },
            "headers": {
              "PAYMENT-REQUIRED": {
                "description": "Base64-encoded JSON PaymentRequired object (x402 V2 wire format). scheme=\"exact\", network=\"inr-fiat:razorpay-test\" (a documented, non-CAIP x402 Extension network id — see extensionDisclaimer on GET /agent/v1/discovery and docs/x402-conformance-diff.md). Carries a formal extensions.{info,schema} block with the same disclaimer, per the spec own Extensions mechanism. Settlement is processed via Razorpay (India, fiat, test-mode). This is not an onchain settlement network. network values under the inr-fiat: prefix are a documented x402 extension for this deployment, not part of the core x402 network registry.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "description": "Returns 402 with the quoted amount in the JSON body (Phase 4a/4b shape, unchanged) AND a PAYMENT-REQUIRED header (x402 V2 wire format). Both describe the same terms_reference/amount — see docs/x402-conformance-diff.md."
      }
    },
    "/agent/v1/pay": {
      "post": {
        "summary": "Agent Pay",
        "operationId": "agent_pay_agent_v1_pay_post",
        "parameters": [
          {
            "name": "PAYMENT-SIGNATURE",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Payment-Signature"
            },
            "description": "Base64-encoded JSON PaymentPayload object. REQUIRED fields: accepted (the full PaymentRequirements object being paid with — normally echoed verbatim from PAYMENT-REQUIRED.accepts[0]) and payload.custodialReceipt (terms_reference + approval_token) — this system's non-cryptographic substitute for a signed authorization (see CustodialReceipt in backend/app/agent_commerce/schemas.py). A missing or malformed value, including a missing accepted field, is rejected with 400, never a silent pass-through. See docs/x402-conformance-diff.md."
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PayRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayResponse"
                }
              }
            },
            "headers": {
              "PAYMENT-RESPONSE": {
                "description": "Base64-encoded JSON SettlementResponse object, present on BOTH success and failure responses from this endpoint (402 on failure, 200 on success — per the spec own 402-for-payment-failure mapping, see docs/x402-conformance-diff.md). settlementType is always \"fiat-custodial\", never \"onchain\". transaction/reference both hold a Razorpay razorpay_order_id (never a razorpay_payment_id/\"pay_...\" string — capture is asynchronous, via webhook, after this response is sent). Settlement is processed via Razorpay (India, fiat, test-mode). This is not an onchain settlement network. network values under the inr-fiat: prefix are a documented x402 extension for this deployment, not part of the core x402 network registry.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "400": {
            "description": "Missing or malformed PAYMENT-SIGNATURE header (including a missing required accepted field), or its custodialReceipt does not match the request body's terms_reference/approval_token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "402": {
            "description": "Payment settlement failed — unknown or already-used terms_reference. Uses 402, not 404, per the x402 V2 spec own HTTP status mapping (402 used for both payment-required AND payment-failed scenarios). See docs/x402-conformance-diff.md.",
            "headers": {
              "PAYMENT-RESPONSE": {
                "description": "Base64-encoded JSON SettlementResponse object, present on BOTH success and failure responses from this endpoint (402 on failure, 200 on success — per the spec own 402-for-payment-failure mapping, see docs/x402-conformance-diff.md). settlementType is always \"fiat-custodial\", never \"onchain\". transaction/reference both hold a Razorpay razorpay_order_id (never a razorpay_payment_id/\"pay_...\" string — capture is asynchronous, via webhook, after this response is sent). Settlement is processed via Razorpay (India, fiat, test-mode). This is not an onchain settlement network. network values under the inr-fiat: prefix are a documented x402 extension for this deployment, not part of the core x402 network registry.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "description": "Settles a previously-quoted purchase via Razorpay test-mode. The PAYMENT-SIGNATURE request header is REQUIRED, and must carry a full accepted PaymentRequirements object (not a flattened scheme/network shape — a real conformance gap found and fixed, see docs/x402-conformance-diff.md). A settlement failure returns 402 (not 404). PAYMENT-RESPONSE is always set on the response, success or failure."
      }
    },

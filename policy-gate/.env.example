# Genuinely separate from the backend's DB file — this is the actual
# service boundary the architecture argues for, not cosmetic. NEVER point
# this at the backend's own database. For Render, use a SEPARATE Postgres
# instance (or at minimum a separate database within the same instance)
# from the backend's — sharing one database would quietly turn "two
# independent services" back into "one logical authority with an HTTP
# detour," which defeats the actual point of this service existing.
# Schema is Alembic-managed (`alembic upgrade head`).
DATABASE_URL=sqlite:///./policy_gate.db

# Two independent uses: (1) mints approval_token (HMAC-style: session_id +
# final terms + this secret), and (2) authenticates the backend's
# admin-only calls to POST/PUT/DELETE /rules (app/routes/rules.py) —
# adjusting discount limits from the Merchant Dashboard. Must match the
# backend's own GATE_SECRET (backend/.env.example) exactly. Generate a
# real random value, e.g. `openssl rand -hex 32` — never commit a real
# secret.
GATE_SECRET=change-me-to-a-real-random-secret

PORT=8001

# Read-only price cross-check (WHAT_BROKE.md #9 fix) — /evaluate calls
# GET {BACKEND_URL}/product/{id} to verify a caller's claimed
# original_price against the real catalog instead of trusting it
# outright. Must be 127.0.0.1, not localhost (~2s slower on this stack —
# see the main README's "Known Gotchas").
BACKEND_URL=http://127.0.0.1:8010

# Presentation-only — has ZERO effect on /evaluate or /verify's decision
# logic. See app/config.py's comment for why this can never be allowed
# to change.
DEMO_MODE=0
